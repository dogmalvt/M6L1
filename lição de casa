import sounddevice as sd
import scipy.io.wavfile as wav
import speech_recognition as sr
from googletrans import Translator
import random
import pyttsx3

# Configuração da voz
engine = pyttsx3.init()

def speak(text):
    print(text)
    engine.say(text)
    engine.runAndWait()

duration = 5
sample_rate = 44100

speak("Hello my dear student")
speak("Welcome to Trilingo")

words_by_level = {
    "fácil": ["gato", "cachorro", "maçã", "leite", "sol"],
    "médio": ["casa", "escola", "amigo", "janela", "amarelo"],
    "difícil": ["tecnologia", "universidade", "informação", "pronúncia", "imaginação"]
}

speak("Available levels: fácil, médio, difícil")
nivel = input("Escolha o nível: ").lower()

if nivel not in words_by_level:
    speak("This level does not exist.")
    exit()

translator = Translator()
pontos = 0
erros = 0

speak("Let's start! You can make up to three mistakes.")

while erros < 3:
    palavra_pt = random.choice(words_by_level[nivel])

    speak(f"Translate this word to English: {palavra_pt}")
    speak("Speak now")

    recording = sd.rec(
        int(duration * sample_rate),
        samplerate=sample_rate,
        channels=1,
        dtype="int16"
    )
    sd.wait()

    wav.write("output.wav", sample_rate, recording)
    speak("Audio recorded")

    recognizer = sr.Recognizer()

    with sr.AudioFile("output.wav") as source:
        audio = recognizer.record(source)

    try:
        texto = recognizer.recognize_google(audio, language="en-US")
        speak(f"You said {texto}")

        traducao = translator.translate(palavra_pt, dest="en")
        correta = traducao.text.lower()
        resposta = texto.lower()

        if correta in resposta:
            speak("Correct!")
            pontos += 1
        else:
            speak(f"Wrong! The correct answer is {correta}")
            erros += 1

        print(f"📊 Pontos: {pontos} | Erros: {erros}/3")

    except sr.UnknownValueError:
        speak("I could not understand what you said.")
        erros += 1

    except sr.RequestError as e:
        speak("There was an error with the speech recognition service.")
        print(e)
        break

speak("Game Over")
speak(f"Your final score was {pontos}")
